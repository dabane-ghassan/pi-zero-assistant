{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "src/cloud-api/gemini-llm.ts",
    "src/cloud-api/gemini.ts",
    "src/cloud-api/openai.ts",
    "src/cloud-api/proxy-fetch.ts",
    "src/config/image-generation.ts",
    "src/utils/index.ts"
  ]
}