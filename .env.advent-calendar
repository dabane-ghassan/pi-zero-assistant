# Offline French Advent Calendar Configuration
# No internet connection required - all services run locally

# Core offline settings
ASR_SERVER=offline                          # Local French phrase detection
LLM_SERVER=offline                          # Local advent calendar logic
TTS_SERVER=piper                            # Local Piper TTS for French
IMAGE_GENERATION_SERVER=                    # Leave empty (not used in advent calendar)

# Piper TTS Configuration (French)
PIPER_BINARY_PATH=/usr/bin/piper            # Path to Piper TTS binary
PIPER_MODEL_PATH=/home/pi/piper/voices/fr_FR-maeva-medium.onnx  # French female voice

# Chat history settings
CHAT_HISTORY_RESET_TIME=60                  # Reset conversation after 60 seconds of inactivity

# Optional: System prompt (not used in advent calendar, but kept for compatibility)
SYSTEM_PROMPT=Tu es une assistant joyeuse qui adore l'Avent!

# Local services (if using alternatives to offline mode)
OLLAMA_ENDPOINT=http://localhost:11434      # Local Ollama if switching to LLM mode
OLLAMA_MODEL=neural-chat:latest             # Ollama model

# Vosk configuration (alternative to offline ASR)
VOSK_MODEL_PATH=/home/pi/vosk-models/small  # Vosk model path
